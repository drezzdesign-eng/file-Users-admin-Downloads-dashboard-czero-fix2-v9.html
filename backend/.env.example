# Copy to .env (never commit .env). On the VPS it lives at /opt/czero-dashboard-api/.env

POSTGRES_USER=czero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=czero_dashboard

# Long random string, 32+ characters (e.g. `openssl rand -base64 48`)
Auth__JwtKey=change-me-to-a-long-random-string-at-least-32-chars

# Ops Monitor ⚙ Settings PIN (was hard-coded as 1234 in index.html)
Auth__OpsAdminPin=change-me

# Coaching page logins (were hard-coded in coaching.html)
Auth__CoachingAdminPassword=change-me
Auth__CoachingHrPassword=change-me

# Only when opening the HTML pages from another origin for local testing, e.g.
# Cors__Origins__0=http://localhost:5500
